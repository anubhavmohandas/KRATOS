# KRATOS configuration. Copy to .env (start.sh does this on first run). .env is gitignored.

# --- AI (optional) -------------------------------------------------------------
# Without a key everything works except "Why this plan?", Ask KRATOS and AI PDF parsing.
# NVIDIA NIM key: https://build.nvidia.com → any model page → "Get API Key" (starts with nvapi-)
# NVIDIA_API_KEY is also accepted instead of KRATOS_LLM_API_KEY.
KRATOS_LLM_API_KEY=
KRATOS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
KRATOS_LLM_MODEL=meta/llama-3.3-70b-instruct
# Any OpenAI-compatible endpoint works, e.g. KRATOS_LLM_BASE_URL=https://api.openai.com/v1

# --- Access (required) ---------------------------------------------------------
# One password guards every page and API route, /api/docs included. 12+ characters.
# Changing it logs every device out.
KRATOS_PASSWORD=

# --- Server (optional) ---------------------------------------------------------
# KRATOS_DB=/absolute/path/to/kratos.db       # default: api/kratos.db
# KRATOS_HOSTS=localhost,127.0.0.1            # Host headers the API accepts; add your domain when deployed
